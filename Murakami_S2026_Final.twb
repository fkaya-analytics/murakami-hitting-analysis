      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:batted_ball_type:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>%null%</bucket>
            </map>
            <map to='#4e79a7'>
              <bucket>&quot;Line Drive&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;Ground Ball&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Fly Ball&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Popup&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:pa_result:nk]' type='palette'>
            <map to='#2a5783'>
              <bucket>&quot;Hit By Pitch&quot;</bucket>
